# Postgres connection string (Neon / Vercel Postgres / Supabase / local)
DATABASE_URL=postgres://user:password@host:5432/genesis
# Long random string — e.g. `openssl rand -hex 32`
PAYLOAD_SECRET=
# Public address of the site, no trailing slash
NEXT_PUBLIC_SERVER_URL=https://genesis.rw
# Vercel Blob token for photo/video storage (Vercel → Storage → Blob). Leave empty locally.
BLOB_READ_WRITE_TOKEN=
# First studio login, created by the initial content migration
SEED_ADMIN_EMAIL=admin@genesis.rw
SEED_ADMIN_PASSWORD=
